<!-- PROJECTS -->
<section id="projects">
  <div class="section-header">
    <span class="section-number">// 01</span>
    <h2 class="section-title">PROJECTS</h2>
    <div class="section-line"></div>
  </div>
  <div class="projects-grid">

    <!-- 1. Centrifugal Fuel Pump -->
    <div class="project-card featured">
      <span class="project-tag tag-burpg">BURPG</span>
      <div class="project-visual">
        <div class="project-visual-bg v-rocket"></div>
        <span>PUMP</span>
      </div>
      <div class="project-body">
        <div class="project-index">01 — Mechanical Design + Electronics</div>
        <h3 class="project-title">CENTRIFUGAL FUEL PUMP</h3>
        <p class="project-desc">
          Designed a compact centrifugal pump assembly for the BU Rocket Propulsion Group's liquid bipropellant system.
          Sized from first principles using Bernoulli, continuity, and momentum equations to meet a 75 mL/s flow rate
          and 21 ft head target. Built for rapid prototyping: 3D-printed housing and impeller, machined aluminum shaft.
          Also designed a custom MOSFET H-bridge motor driver in KiCad with a 555-timer PWM stage for speed and direction control.
        </p>
        <div class="project-pills">
          <span class="pill">SolidWorks</span>
          <span class="pill">KiCad</span>
          <span class="pill">3D Printing</span>
          <span class="pill">Lathe &amp; Mill</span>
          <span class="pill">Fluid Mechanics</span>
          <span class="pill">H-Bridge</span>
        </div>
      </div>
    </div>

    <!-- 2. Tube Swaging Automation -->
    <div class="project-card featured">
      <span class="project-tag tag-capstone">Capstone</span>
      <div class="project-visual">
        <div class="project-visual-bg v-swage"></div>
        <span>AUTO</span>
      </div>
      <div class="project-body">
        <div class="project-index">02 — Automation + Controls</div>
        <h3 class="project-title">TUBE SWAGING AUTOMATION</h3>
        <p class="project-desc">
          Senior capstone project for VitaNeedle. Developed a benchtop automation system to replace manual tube loading
          and positioning in their swaging process. Designed and machined the gripper and mounting hardware, built the
